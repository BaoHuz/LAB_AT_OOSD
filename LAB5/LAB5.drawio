      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nautonumber\nactor \&quot;NV kinh doanh\&quot; as NV\nboundary \&quot;FrmDangKyDoan\&quot; as Form\ncontrol \&quot;DangKyDoanService\&quot; as Service\nentity \&quot;DangKyDoan\&quot; as EntityDK\nentity \&quot;PhanCongHDV\&quot; as EntityPC\n\nNV -&gt; Form : Click \&quot;Hủy phiếu (mất cọc)\&quot; (soDK)\nactivate Form\n\nForm -&gt; Service : HuyDangKy(soDK)\nactivate Service\n\nService -&gt; EntityDK : LayThongTin(soDK)\nactivate EntityDK\nEntityDK --&gt; Service : TrangThai, NgayDi\ndeactivate EntityDK\n\nalt#Gold TrangThai != &#39;Đã đăng ký&#39; OR NgayDi &lt;= Today\n    Service --&gt; Form : KetQuaXuLy.Fail(\&quot;Không thể hủy phiếu\&quot;)\nelse Hợp lệ [Trong 1 Transaction]\n    Service -&gt; EntityPC : DeletePhanCong(soDK)\n    activate EntityPC\n    EntityPC --&gt; Service : OK\n    deactivate EntityPC\n    \n    Service -&gt; EntityDK : UpdateTrangThai(soDK, \&quot;Hủy - mất cọc\&quot;)\n    activate EntityDK\n    EntityDK --&gt; Service : OK\n    deactivate EntityDK\n    \n    Service --&gt; Form : KetQuaXuLy.Ok(\&quot;Đã hủy phiếu, gỡ phân công, mất cọc\&quot;)\nend\n\nForm --&gt; NV : Hiển thị thông báo &amp; Nạp lại danh sách\ndeactivate Form\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="DGCnHOqsPXv6v5w48DdP-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlId="grpbg_10" plantUmlBaseStyle="rounded=0;fillColor=#FFD700;strokeColor=none;" plantUmlBaseValue="" id="DGCnHOqsPXv6v5w48DdP-2">

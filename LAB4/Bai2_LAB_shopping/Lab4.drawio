        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\n&#39; =========================\n&#39; STYLE\n&#39; =========================\n\nskinparam class {\n    BackgroundColor #FFF9C4\n    BorderColor #C44A5A\n    ArrowColor #C44A5A\n    FontColor #333333\n\n    FontSize 12\n    AttributeFontSize 11\n    HeaderFontSize 13\n}\n\nskinparam {\n    linetype ortho\n    nodesep 60\n    ranksep 70\n\n    ClassAttributeIconSize 0\n    shadowing false\n}\n\nhide empty methods\n\n\n&#39; =========================\n&#39; CLASS\n&#39; =========================\n\nclass KhachHang {\n    MaKH : String\n    HoTen : String\n    DiaChi : String\n    DienThoai : String\n    Email : String\n    TenDangNhap : String\n    MatKhau : String\n}\n\nclass GioHang {\n    DanhSachItem : List\n    TinhTongTien() : Decimal\n}\n\nclass GioHangItem {\n    SoLuong : Integer\n    TinhThanhTien() : Decimal\n}\n\nclass SanPham {\n    MaSP : String\n    TenSP : String\n    GiaBanHienHang : Decimal\n    TinhTrang : String\n}\n\nclass DonHang {\n    MaDH : String\n    ThoiDiemDat : DateTime\n    NguoiNhanHoTen : String\n    NguoiNhanDiaChi : String\n    LoaiPhieuDat : String\n    ChiPhiGiaoHang : Decimal\n    TongTriGia : Decimal\n}\n\nclass ChiTietDonHang {\n    SoLuong : Integer\n    DonGia : Decimal\n}\n\n\n&#39; =========================\n&#39; RELATIONSHIPS\n&#39; =========================\n\nKhachHang \&quot;1\&quot; -down-&gt; \&quot;0..*\&quot; DonHang\n\nDonHang \&quot;1\&quot; *-down-&gt; \&quot;1..*\&quot; ChiTietDonHang\n\nSanPham \&quot;1\&quot; -down-&gt; \&quot;0..*\&quot; ChiTietDonHang\n\n\n&#39; =========================\n&#39; SHOPPING CART\n&#39; =========================\n\nGioHang \&quot;1\&quot; *-down-&gt; \&quot;0..*\&quot; GioHangItem\n\nGioHangItem \&quot;0..*\&quot; -down-&gt; \&quot;1\&quot; SanPham\n\n\n&#39; =========================\n&#39; LAYOUT CONTROL\n&#39; =========================\n\nKhachHang -[hidden]right- GioHang\n\nDonHang -[hidden]right- SanPham\n\nGioHangItem -[hidden]right- ChiTietDonHang\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="E0Or2dYpymJV8sYNymX7-141">

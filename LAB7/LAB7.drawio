        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide circle\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam linetype ortho\n\nentity PhongBan {\n  * MaPB : varchar &lt;&lt;PK&gt;&gt;\n  --\n  TenPB : nvarchar\n}\nentity NhanVien {\n  * MaNV : varchar &lt;&lt;PK&gt;&gt;\n  --\n  MaPB : varchar &lt;&lt;FK&gt;&gt;\n  HoTen : nvarchar\n  TrangThai : nvarchar\n}\nentity ChucVu {\n  * MaCV : varchar &lt;&lt;PK&gt;&gt;\n  --\n  TenCV : nvarchar\n}\nentity CaLamViec {\n  * MaCa : varchar &lt;&lt;PK&gt;&gt;\n  --\n  TenCa : nvarchar\n}\nentity QuyetDinhTuyenDung {\n  * SoQDTD : varchar &lt;&lt;PK&gt;&gt;\n  --\n  MaNV : varchar &lt;&lt;FK&gt;&gt;\n  MaPBThuViec : varchar &lt;&lt;FK&gt;&gt;\n  TuNgay : date\n  DenNgay : date\n  LuongThuViec : decimal\n}\nentity HopDongLaoDong {\n  * SoHD : varchar &lt;&lt;PK&gt;&gt;\n  --\n  MaNV : varchar &lt;&lt;FK&gt;&gt;\n  LoaiHD : nvarchar\n  TuNgay : date\n  DenNgay : date?\n}\nentity HoSoBaoHiem {\n  * MaHSBH : varchar &lt;&lt;PK&gt;&gt;\n  --\n  MaNV : varchar &lt;&lt;FK&gt;&gt;\n  SoHD : varchar &lt;&lt;FK&gt;&gt;\n  LoaiBH : nvarchar\n  TyLeNguoiLD : decimal\n}\nentity QuyetDinhChucVu {\n  * SoQDCV : varchar &lt;&lt;PK&gt;&gt;\n  --\n  MaNV : varchar &lt;&lt;FK&gt;&gt;\n  MaCV : varchar &lt;&lt;FK&gt;&gt;\n  NgayHieuLuc : date\n  PhuCapChucVu : decimal\n}\nentity QuyetDinhLuong {\n  * SoQDL : varchar &lt;&lt;PK&gt;&gt;\n  --\n  MaNV : varchar &lt;&lt;FK&gt;&gt;\n  NgayHieuLuc : date\n  LuongCoBan : decimal\n  PhuCapLuong : decimal\n  PhuCapDocHai : decimal\n}\nentity KeHoachTuan {\n  * MaKH : varchar &lt;&lt;PK&gt;&gt;\n  --\n  MaPB : varchar &lt;&lt;FK&gt;&gt;\n  TuanTuNgay : date\n  TuanDenNgay : date\n}\nentity ChiTietKeHoachTuan {\n  * MaKH : varchar &lt;&lt;PK,FK&gt;&gt;\n  * STT : int &lt;&lt;PK&gt;&gt;\n  --\n  MaNV : varchar &lt;&lt;FK&gt;&gt;\n  MaCa : varchar &lt;&lt;FK&gt;&gt;\n  NgayLam : date\n}\nentity PhieuChamCong {\n  * MaCC : varchar &lt;&lt;PK&gt;&gt;\n  --\n  MaNV : varchar &lt;&lt;FK&gt;&gt;\n  MaCa : varchar &lt;&lt;FK&gt;&gt;\n  NgayCham : date\n  SoGioLam : decimal\n}\nentity PhieuPhuTroi {\n  * SoPhieu : varchar &lt;&lt;PK&gt;&gt;\n  --\n  NgayPhuTroi : date\n  SoGioPhuTroi : decimal\n  HeSo : decimal = 1.5\n}\nentity ChiTietPhuTroi {\n  * SoPhieu : varchar &lt;&lt;PK,FK&gt;&gt;\n  * MaNV : varchar &lt;&lt;PK,FK&gt;&gt;\n}\nentity QuyetDinhKhenThuong {\n  * SoQDKT : varchar &lt;&lt;PK&gt;&gt;\n  --\n  MaNV : varchar? &lt;&lt;FK&gt;&gt;\n  MaPB : varchar? &lt;&lt;FK&gt;&gt;\n  SoTien : decimal\n}\nentity PhieuChiKhenThuong {\n  * SoPhieuChi : varchar &lt;&lt;PK&gt;&gt;\n  --\n  SoQDKT : varchar &lt;&lt;FK&gt;&gt;\n  SoTien : decimal\n}\nentity QuyetDinhKyLuat {\n  * SoQDKL : varchar &lt;&lt;PK&gt;&gt;\n  --\n  MaNV : varchar? &lt;&lt;FK&gt;&gt;\n  MaPB : varchar? &lt;&lt;FK&gt;&gt;\n  SoTienPhat : decimal\n  CachThu : nvarchar\n}\nentity PhieuThuNopPhat {\n  * SoPhieuThu : varchar &lt;&lt;PK&gt;&gt;\n  --\n  SoQDKL : varchar &lt;&lt;FK&gt;&gt;\n  SoTien : decimal\n}\nentity CauHinhTinhLuong {\n  * Thang : int &lt;&lt;PK&gt;&gt;\n  * Nam : int &lt;&lt;PK&gt;&gt;\n  --\n  NgayCongChuan : decimal\n  GioCongChuanNgay : decimal\n}\nentity BangLuong {\n  * MaBangLuong : varchar &lt;&lt;PK&gt;&gt;\n  --\n  Thang : int\n  Nam : int\n}\nentity ChiTietBangLuong {\n  * MaBangLuong : varchar &lt;&lt;PK,FK&gt;&gt;\n  * MaNV : varchar &lt;&lt;PK,FK&gt;&gt;\n  --\n  TienTheoCong : decimal\n  TienPhuTroi : decimal\n  KhauTruBH : decimal\n  KhauTruKL : decimal\n  ThucLinh : decimal\n}\n\nPhongBan ||--o{ NhanVien\nNhanVien ||--o{ QuyetDinhTuyenDung\nPhongBan ||--o{ QuyetDinhTuyenDung : thử việc\nNhanVien ||--o{ HopDongLaoDong\nHopDongLaoDong ||--o{ HoSoBaoHiem\nNhanVien ||--o{ HoSoBaoHiem\nNhanVien ||--o{ QuyetDinhChucVu\nChucVu ||--o{ QuyetDinhChucVu\nNhanVien ||--o{ QuyetDinhLuong\nPhongBan ||--o{ KeHoachTuan\nKeHoachTuan ||--|{ ChiTietKeHoachTuan\nNhanVien ||--o{ ChiTietKeHoachTuan\nCaLamViec ||--o{ ChiTietKeHoachTuan\nNhanVien ||--o{ PhieuChamCong\nCaLamViec ||--o{ PhieuChamCong\nPhieuPhuTroi ||--|{ ChiTietPhuTroi\nNhanVien ||--o{ ChiTietPhuTroi\nNhanVien |o--o{ QuyetDinhKhenThuong\nPhongBan |o--o{ QuyetDinhKhenThuong\nQuyetDinhKhenThuong ||--o| PhieuChiKhenThuong\nNhanVien |o--o{ QuyetDinhKyLuat\nPhongBan |o--o{ QuyetDinhKyLuat\nQuyetDinhKyLuat ||--o| PhieuThuNopPhat\nCauHinhTinhLuong ||--o{ BangLuong\nBangLuong ||--|{ ChiTietBangLuong\nNhanVien ||--o{ ChiTietBangLuong\n\nnote right of QuyetDinhKhenThuong\nCHECK: đúng một trong MaNV / MaPB có giá trị.\nend note\nnote right of QuyetDinhKyLuat\nCHECK: đúng một trong MaNV / MaPB có giá trị.\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="99OnUj-4jYbulVMHtqau-1">

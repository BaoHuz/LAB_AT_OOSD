        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide empty description\n\nstate \&quot;Lịch hẹn định kỳ\&quot; as Lich {\n  state \&quot;Đã hẹn\&quot; as DaHen\n  state \&quot;Đã hủy\&quot; as Huy\n  state \&quot;Đã khám\&quot; as DaKham\n\n  [*] --&gt; DaHen : datLichHen()\\n[du dieu kien]\n\n  DaHen : entry / hienThiThongTinLichHen()\n  DaHen : do / choBenhNhanDenKham()\n  DaHen --&gt; DaHen : doiHen()\\n[con quyen loi va chua co phieu]\n\n  DaHen --&gt; Huy : huyHen()\\n[chua co phieu kham]\n  Huy : entry / ghiNhanHuyVaGiaiPhongLichQuy()\n  Huy --&gt; [*]\n\n  DaHen --&gt; DaKham : tiepNhan()\\n[dung ho so, ngay hen va con quyen loi]\n  DaKham : entry / hienThiPhieuKhamDaLienKet()\n  DaKham --&gt; [*]\n}\n\nstate \&quot;Hóa đơn viện phí\&quot; as HD {\n  state \&quot;Chưa thanh toán\&quot; as ChuaThanhToan\n  state \&quot;Đã thanh toán\&quot; as DaThanhToan\n\n  [*] --&gt; ChuaThanhToan : lapHoaDon()\n\n  ChuaThanhToan : entry / hienThiBangKeVaTongTien()\n  ChuaThanhToan : do / choXacNhanThanhToan()\n\n  ChuaThanhToan --&gt; DaThanhToan : thuDuTien()\\n[tong &gt; 0 va so tien = tong]\n  ChuaThanhToan --&gt; DaThanhToan : xacNhanMienPhi()\\n[tong = 0]\n\n  DaThanhToan : entry / hienThiThoiDiemXacNhan()\n  DaThanhToan : entry / khoaSuaTrucTiepHoaDon()\n  DaThanhToan --&gt; [*]\n}\n\nnote bottom of DaKham\n  Tạo phiếu khám và chuyển lịch sang DaKham\n  phải nằm trong cùng một transaction.\nend note\n\nnote bottom of DaThanhToan\n  Cập nhật DaThanhToan và NgayThanhToan\n  trong cùng transaction xác nhận.\n  Hóa đơn 0 đồng không phát sinh thu tiền.\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="yCVSXCwjV-U4XHqPcJQz-23">

  <diagram id="HlHYSRPU2OaLCAlyQEzT" name="Use Case tổng quát">
    <mxGraphModel dx="3169" dy="1221" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam actorStyle stickman\n\n&#39; Khai báo các Actor\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;NV Lễ tân / Tiếp nhận\&quot; as NVLT\nactor \&quot;Bác sĩ điều trị\&quot; as BS\nactor \&quot;NV Xét nghiệm\&quot; as NVXN\nactor \&quot;Dược sĩ / Tủ thuốc\&quot; as DS\nactor \&quot;NV Thu ngân / Kế toán\&quot; as KT\n\nrectangle \&quot;Hệ Thống Quản Lý Hồ Sơ Bệnh Án\&quot; {\n\n    &#39; Nhóm Quản lý Danh mục\n    usecase \&quot;Quản lý danh mục bác sĩ / khoa\&quot; as UC_QLDanhMuc\n    usecase \&quot;Quản lý danh mục thuốc / xét nghiệm\&quot; as UC_QLThuocXN\n\n    &#39; Nhóm Tiếp nhận &amp; Hồ sơ\n    usecase \&quot;Đăng ký bệnh nhân mới\&quot; as UC_DKBN\n    usecase \&quot;Thu lệ phí năm &amp; Cấp hồ sơ\&quot; as UC_CapHoSo\n    usecase \&quot;Tra cứu lịch sử bệnh án\&quot; as UC_TraCuu\n    usecase \&quot;Xếp lịch hẹn khám định kỳ quý\&quot; as UC_LichHen\n\n    &#39; Nhóm Khám bệnh &amp; Cận lâm sàng\n    usecase \&quot;Khám bệnh &amp; Ghi triệu chứng\&quot; as UC_KhamBenh\n    usecase \&quot;Chỉ định xét nghiệm\&quot; as UC_ChiDinhXN\n    usecase \&quot;Thực hiện &amp; Cập nhật kết quả XN\&quot; as UC_CapNhatXN\n    usecase \&quot;Lập toa thuốc điều trị\&quot; as UC_LapToa\n\n    &#39; Nhóm Thanh toán &amp; Hoàn tất\n    usecase \&quot;Thanh toán viện phí đợt khám\&quot; as UC_ThanhToan\n    usecase \&quot;Phát thuốc cho bệnh nhân\&quot; as UC_PhatThuoc\n    usecase \&quot;Hoàn tất &amp; Chốt hồ sơ đợt khám\&quot; as UC_HoanTat\n}\n\n&#39; Liên kết Actor với Use Case\n\n&#39; Bệnh nhân\nBN -- UC_DKBN\nBN -- UC_LichHen\n\n&#39; NV Lễ tân / Tiếp nhận\nNVLT -- UC_DKBN\nNVLT -- UC_CapHoSo\nNVLT -- UC_TraCuu\nNVLT -- UC_LichHen\nNVLT -- UC_HoanTat\n\n&#39; Bác sĩ điều trị\nBS -- UC_TraCuu\nBS -- UC_KhamBenh\nBS -- UC_ChiDinhXN\nBS -- UC_LapToa\nBS -- UC_QLDanhMuc\n\n&#39; NV Xét nghiệm\nNVXN -- UC_CapNhatXN\n\n&#39; Dược sĩ\nDS -- UC_PhatThuoc\nDS -- UC_QLThuocXN\n\n&#39; NV Thu ngân / Kế toán\nKT -- UC_CapHoSo\nKT -- UC_ThanhToan\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="O8qP5TGFsleULuECcWNz-1">

  <diagram id="vyCXXJvXk2LNuwdCTOHj" name="Trang-6">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\n&#39; ============================================================\n&#39; CẤU HÌNH\n&#39; ============================================================\n\nskinparam backgroundColor white\n\nskinparam class {\n    BackgroundColor #FFF9CC\n    BorderColor #CC3333\n    FontColor #000000\n    FontSize 10\n    AttributeFontSize 9\n    MethodFontSize 9\n    HeaderFontSize 10\n}\n\nskinparam ArrowColor #CC3333\nskinparam ArrowThickness 1\nskinparam ClassAttributeIconSize 0\nskinparam shadowing false\n\nskinparam nodesep 40\nskinparam ranksep 50\n\n\n&#39; ============================================================\n&#39; KHÁCH HÀNG\n&#39; ============================================================\n\nclass KhachHang {\n\n    MaKH : String\n    HoTen : String\n    NgaySinh : DateTime\n    CMND : String\n    DiaChi : String\n    DienThoai : String\n    TenDangNhap : String\n    MatKhau : String\n    Email : String\n\n    --\n\n    themKhachHang()\n    layDanhSach()\n}\n\n\n&#39; ============================================================\n&#39; NHÓM SẢN PHẨM\n&#39; ============================================================\n\nclass NhomSanPham {\n\n    MaNhom : String\n    TenNhom : String\n\n    --\n\n    themNhomSanPham()\n    layDanhSach()\n}\n\n\n&#39; ============================================================\n&#39; SẢN PHẨM\n&#39; ============================================================\n\nclass SanPham {\n\n    MaSP : String\n    MaNhom : String\n    TenSP : String\n    NhaSanXuat : String\n    HinhAnh : String\n    MoTa : String\n    GiaBanHienHang : Decimal\n    TinhTrang : Boolean\n\n    --\n\n    themSanPham()\n    suaSanPham()\n    xoaSanPham()\n    layDanhSach()\n}\n\n\n&#39; ============================================================\n&#39; ĐƠN HÀNG\n&#39; ============================================================\n\nclass DonHang {\n\n    MaDH : String\n    MaKH : String\n    ThoiDiemDat : DateTime\n    NguoiNhanHoTen : String\n    NguoiNhanDiaChi : String\n    NguoiNhanDienThoai : String\n    LoaiPhieuDat : String\n    ChiPhiGiaoHang : Decimal\n    TongTriGia : Decimal\n    LoaiTheThanhToan : String\n    SoTheMasked : String\n    TrangThai : String\n\n    --\n\n    themDonHang()\n    layDanhSach()\n}\n\n\n&#39; ============================================================\n&#39; CHI TIẾT ĐƠN HÀNG\n&#39; ============================================================\n\nclass ChiTietDonHang {\n\n    MaDH : String\n    MaSP : String\n    SoLuong : Integer\n    DonGia : Decimal\n\n    --\n\n    themChiTiet()\n    suaChiTiet()\n    xoaChiTiet()\n    tinhThanhTien()\n}\n\n\n&#39; ============================================================\n&#39; THẺ THANH TOÁN\n&#39; ============================================================\n\nclass PaymentCard {\n\n    LoaiThe : String\n    SoThe : String\n    NgayHetHan : String\n    ChuThe : String\n    CSV : String\n\n    --\n\n    ValidateFormat(err : String) : Boolean\n}\n\n\n&#39; ============================================================\n&#39; QUAN HỆ CÓ MŨI TÊN\n&#39; ============================================================\n\n&#39; NhomSanPham 1 ----&gt; 0..* SanPham\nNhomSanPham \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SanPham\n\n\n&#39; KhachHang 1 ----&gt; 0..* DonHang\nKhachHang \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DonHang\n\n\n&#39; DonHang 1 ----&gt; 1..* ChiTietDonHang\n&#39; Dùng composition: hình thoi đen + mũi tên\nDonHang \&quot;1\&quot; *--&gt; \&quot;1..*\&quot; ChiTietDonHang\n\n\n&#39; SanPham 1 ----&gt; 0..* ChiTietDonHang\nSanPham \&quot;1\&quot; --&gt; \&quot;0..*\&quot; ChiTietDonHang\n\n\n&#39; DonHang 1 ----&gt; 0..1 PaymentCard\nDonHang \&quot;1\&quot; --&gt; \&quot;0..1\&quot; PaymentCard\n\n\n&#39; ============================================================\n&#39; BỐ CỤC\n&#39; ============================================================\n\nNhomSanPham -[hidden]right-&gt; KhachHang\n\nNhomSanPham -[hidden]down-&gt; SanPham\n\nKhachHang -[hidden]down-&gt; DonHang\n\nSanPham -[hidden]right-&gt; ChiTietDonHang\n\nDonHang -[hidden]down-&gt; ChiTietDonHang\n\nDonHang -[hidden]right-&gt; PaymentCard\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CWmTvxwCBttsdDXMwpOl-283">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

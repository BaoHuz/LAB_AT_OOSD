  <diagram id="foQ1hG1-i1r7PMplr4Vg" name="State_DonHang">
    <mxGraphModel dx="1290" dy="672" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n\n&#39; =========================\n&#39; STYLE\n&#39; =========================\nskinparam state {\n    BackgroundColor #FFF9A6\n    BorderColor #D4B000\n    FontColor #222222\n    FontSize 12\n    RoundCorner 15\n}\n\nskinparam ArrowColor #D94A4A\nskinparam ArrowFontColor #333333\nskinparam ArrowFontSize 11\n\nskinparam defaultTextAlignment center\nskinparam shadowing false\n\n&#39; =========================\n&#39; STATES\n&#39; =========================\n\nstate \&quot;Giỏ hàng khách\&quot; as GioHangKhach\n\nstate \&quot;Đang kiểm tra thanh toán\&quot; as DangKiemTraThanhToan\nDangKiemTraThanhToan : entry / Gửi yêu cầu đến Payment Gateway\n\nstate \&quot;Thanh toán thành công\&quot; as PaymentSuccess\nPaymentSuccess : entry / Lưu transaction vào CSDL\n\nstate \&quot;Thanh toán thất bại\&quot; as PaymentFailed\nPaymentFailed : entry / Hiển thị lỗi thanh toán\n\nstate \&quot;Đã hủy\&quot; as DaHuy\nDaHuy : entry / Hủy giao dịch\n\nstate \&quot;Đã đặt hàng\&quot; as DaDatHang\nDaDatHang : entry / Gửi email xác nhận\n\nstate \&quot;Đang chuyển phát\&quot; as DangChuyenPhat\nDangChuyenPhat : entry / Xuất kho và bắt đầu giao hàng\n\nstate \&quot;Giao hàng thành công\&quot; as GiaoHangThanhCong\nGiaoHangThanhCong : entry / Cập nhật trạng thái đơn hàng\n\n\n&#39; =========================\n&#39; LUỒNG CHÍNH\n&#39; =========================\n\n[*] --&gt; GioHangKhach\n\nGioHangKhach --&gt; DangKiemTraThanhToan :\n    Khách chọn \&quot;Tính tiền\&quot;\\n&amp; nhập thông tin thẻ\n\nDangKiemTraThanhToan --&gt; PaymentSuccess :\n    Thẻ hợp lệ &amp; đủ tiền\n\nPaymentSuccess --&gt; DaDatHang :\n    Transaction lưu CSDL\\n&amp; gửi Email thành công\n\nDaDatHang --&gt; DangChuyenPhat :\n    Xuất kho &amp; bắt đầu giao hàng\n\nDangChuyenPhat --&gt; GiaoHangThanhCong :\n    Người nhận đã nhận hàng\n\nGiaoHangThanhCong --&gt; [*]\n\n\n&#39; =========================\n&#39; NHÁNH THANH TOÁN THẤT BẠI\n&#39; =========================\n\nDangKiemTraThanhToan --&gt; PaymentFailed :\n    Thẻ sai / Không đủ hạn mức\n\nPaymentFailed --&gt; DangKiemTraThanhToan :\n    Thử lại bằng thẻ khác\n\nPaymentFailed --&gt; DaHuy :\n    Khách hủy giao dịch\n\nDaHuy --&gt; [*]\n\n\n&#39; =========================\n&#39; BỐ TRÍ\n&#39; =========================\n\nGioHangKhach -[hidden]-&gt; DangKiemTraThanhToan\nDangKiemTraThanhToan -[hidden]-&gt; PaymentSuccess\nPaymentSuccess -[hidden]-&gt; DaDatHang\nDaDatHang -[hidden]-&gt; DangChuyenPhat\nDangChuyenPhat -[hidden]-&gt; GiaoHangThanhCong\n\n&#39; Đẩy nhánh lỗi xuống dưới\nDangKiemTraThanhToan -[hidden]down-&gt; PaymentFailed\nPaymentFailed -[hidden]down-&gt; DaHuy\n\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="YJxk3HLFBRh8643D14Fz-70">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>

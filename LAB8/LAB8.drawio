        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle THIẾT KẾ LỚP CHO NHÂN VIÊN - THẺ XE - KIỂM TRA PHÒNG\n\nleft to right direction\n\nskinparam shadowing false\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\n\nskinparam class {\n    BackgroundColor #FFF4C2\n    BorderColor #A67C32\n}\n\nclass FrmNhanVien &lt;&lt;boundary&gt;&gt; {\n    + FrmNhanVien_Load()\n    + btnThem_Click()\n    + btnSua_Click()\n    + btnChonAnh_Click()\n    + btnNghiViec_Click()\n}\n\nclass FrmTheGiuXe &lt;&lt;boundary&gt;&gt; {\n    + FrmTheGiuXe_Load()\n    + btnCapThe_Click()\n    + btnSua_Click()\n    + btnKhoa_Click()\n    + btnThuHoi_Click()\n}\n\nclass FrmKiemTraPhong &lt;&lt;boundary&gt;&gt; {\n    + FrmKiemTraPhong_Load()\n    + btnThem_Click()\n    + btnSua_Click()\n    + dgvKiemTra_CellClick()\n}\n\nclass NhanVienService &lt;&lt;control&gt;&gt; {\n    + LayDanhSach()\n    + LayKhachHang()\n    + LayVanPhong()\n    + Them()\n    + Sua()\n    + NghiViec()\n}\n\nclass TheGiuXeService &lt;&lt;control&gt;&gt; {\n    + LayDanhSach()\n    + LayNhanVien()\n    + CapThe()\n    + Sua()\n    + KhoaThe()\n    + ThuHoi()\n}\n\nclass KiemTraPhongService &lt;&lt;control&gt;&gt; {\n    + LayDanhSach()\n    + LayVanPhong()\n    + Them()\n    + Sua()\n}\n\nclass NhanVienVanPhong &lt;&lt;entity&gt;&gt; {\n    - MaNV : String\n    - MaKH : String\n    - MaVP : String\n    - HoTen : String\n    - ChucVu : String\n    - HinhAnh : Byte[]\n    - NgayBatDau : Date\n    - DangLamViec : Boolean\n    --\n    + themNhanVien()\n    + capNhatNhanVien()\n    + chuyenPhong()\n    + nghiViec()\n}\n\nclass TheGiuXe &lt;&lt;entity&gt;&gt; {\n    - MaThe : String\n    - MaNV : String\n    - BienSoXe : String\n    - LoaiXe : String\n    - MauXe : String\n    - NgayCap : Date\n    - TrangThai : String\n    --\n    + capThe()\n    + capNhatThe()\n    + khoaThe()\n    + thuHoi()\n}\n\nclass KiemTraPhong &lt;&lt;entity&gt;&gt; {\n    - MaKT : String\n    - MaVP : String\n    - NgayKiemTra : Date\n    - TinhTrang : String\n    - CoThayDoiKetCau : Boolean\n    - MucPhat : Decimal\n    - KienNghiSuaChua : String\n    --\n    + lapBienBan()\n    + ghiNhanViPham()\n    + deXuatSuaChua()\n}\n\nclass KhachHang &lt;&lt;entity&gt;&gt; {\n    - MaKH : String\n    - TenKhachHang : String\n}\n\nclass VanPhong &lt;&lt;entity&gt;&gt; {\n    - MaVP : String\n    - TenPhong : String\n    - TrangThai : String\n}\n\nFrmNhanVien --&gt; NhanVienService : gọi\nFrmTheGiuXe --&gt; TheGiuXeService : gọi\nFrmKiemTraPhong --&gt; KiemTraPhongService : gọi\n\nNhanVienService --&gt; KhachHang\nNhanVienService --&gt; VanPhong\nNhanVienService --&gt; NhanVienVanPhong\n\nTheGiuXeService --&gt; NhanVienVanPhong\nTheGiuXeService --&gt; TheGiuXe\n\nKiemTraPhongService --&gt; VanPhong\nKiemTraPhongService --&gt; KiemTraPhong\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="jCDEcSIm0VWMa1oEPmFl-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">

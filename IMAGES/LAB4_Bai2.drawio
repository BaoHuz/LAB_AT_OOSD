      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle SEQUENCE DIAGRAM - ĐẶT HÀNG &amp; THANH TOÁN (BẢN NGẮN)\n\nskinparam shadowing false\nautonumber\n\nactor KhachHang\nboundary frmThanhToan\ncontrol OrderService\ncontrol PaymentAdapter\ndatabase SQLServerDB\ncontrol EmailAdapter\n\nKhachHang -&gt; frmThanhToan : Nhấn \&quot;Xác nhận\&quot;\nfrmThanhToan -&gt; OrderService : ProcessOrder(...)\n\nOrderService -&gt; OrderService : CalculateShippingFee()\nOrderService -&gt; PaymentAdapter : VerifyAndPay(...)\n\nalt Thanh toán thất bại\n    PaymentAdapter --&gt; OrderService : false, errorMessage\n    OrderService --&gt; frmThanhToan : ProcessOrder(false, loi)\n    frmThanhToan --&gt; KhachHang : Hiển thị lỗi\nelse Thanh toán thành công\n    PaymentAdapter --&gt; OrderService : true\n\n    OrderService -&gt; SQLServerDB : BeginTransaction()\n    OrderService -&gt; SQLServerDB : Insert DonHang\n    OrderService -&gt; SQLServerDB : Insert ChiTietDonHang\n    OrderService -&gt; SQLServerDB : CommitTransaction()\n\n    OrderService -&gt; EmailAdapter : SendOrderConfirmation(...)\n    EmailAdapter --&gt; OrderService : Kết quả gửi mail\n\n    OrderService --&gt; frmThanhToan : ProcessOrder(true, thành công)\n    frmThanhToan --&gt; KhachHang : Hiển thị mã đơn hàng\nend\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="t0XLhizUvuW-qpFKv5VZ-71">

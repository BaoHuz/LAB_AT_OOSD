        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle THIẾT KẾ LỚP CHO CHỨC NĂNG GIA HẠN\n\nleft to right direction\n\nskinparam shadowing false\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\n\nskinparam class {\n    BackgroundColor #FFF4C2\n    BorderColor #A67C32\n}\n\nclass FrmGiaHan &lt;&lt;boundary&gt;&gt; {\n    + FrmGiaHan_Load()\n    + cboHopDong_SelectedIndexChanged()\n    + cboVanPhong_SelectedIndexChanged()\n    + btnGiaHan_Click()\n    + TaiDuLieu()\n}\n\nclass GiaHanService &lt;&lt;control&gt;&gt; {\n    + LayHopDongHieuLuc()\n    + LayVanPhongTheoHopDong()\n    + LayLichSuGiaHan()\n    + LayDieuKienGiaHan()\n    + KiemTraCongNo()\n    + KiemTraGioiHan()\n    + GiaHan()\n}\n\nclass HopDongThue &lt;&lt;entity&gt;&gt; {\n    - MaHD : String\n    - NgayBatDau : Date\n    - SoThangThue : Integer\n    - NgayKetThuc : Date\n    - TrangThai : String\n    --\n    + tinhNgayKetThuc()\n}\n\nclass ChiTietHopDong &lt;&lt;entity&gt;&gt; {\n    - MaHD : String\n    - MaVP : String\n    - NgayBatDau : Date\n    - NgayKetThuc : Date\n    --\n    + kiemTraChongLich()\n    + capNhatNgayKetThuc()\n}\n\nclass ThanhToanTienThue &lt;&lt;entity&gt;&gt; {\n    - MaHD : String\n    - SoTien : Decimal\n    - TrangThai : String\n    --\n    + conNo()\n}\n\nclass HoaDonDichVu &lt;&lt;entity&gt;&gt; {\n    - MaHD : String\n    - TongTien : Decimal\n    - TrangThai : String\n    --\n    + kiemTraDaThanhToan()\n}\n\nclass PhieuGiaHan &lt;&lt;entity&gt;&gt; {\n    - MaGH : String\n    - MaHD : String\n    - MaVP : String\n    - NgayLap : Date\n    - SoThangGiaHan : Integer\n    - TuNgay : Date\n    - DenNgay : Date\n    --\n    + kiemTraDieuKien()\n    + tinhGioiHanGiaHan()\n    + tinhNgayKetThucMoi()\n    + giaHan()\n}\n\nFrmGiaHan --&gt; GiaHanService : gọi\n\nGiaHanService --&gt; HopDongThue\nGiaHanService --&gt; ChiTietHopDong\nGiaHanService --&gt; ThanhToanTienThue\nGiaHanService --&gt; HoaDonDichVu\nGiaHanService --&gt; PhieuGiaHan\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="6bF-HB8wyRkIq_pNiMFc-1">

  <diagram id="CUQHtDh3O8n7XGLydsjs" name="P05_sequence_giahan">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam sequenceMessageAlign center\n\ntitle SEQUENCE DIAGRAM - LẬP PHIẾU GIA HẠN\n\nactor \&quot;NV quản lý\&quot; as NV\nboundary FrmGiaHan as Form\ncontrol GiaHanService as Service\nentity \&quot;HopDong / CTHD\&quot; as HD\nentity ThanhToan as TT\nentity HoaDonDV as DV\nentity PhieuGiaHan as GH\n\nNV -&gt; Form : Chọn hợp đồng + phòng\nForm -&gt; Service : LayDieuKienGiaHan()\nService -&gt; HD : Lấy thời gian thuê, ngày kết thúc\nHD --&gt; Service : Thông tin hợp đồng\nService -&gt; TT : Kiểm tra nợ tiền thuê\nTT --&gt; Service : Số dư nợ tiền thuê\nService -&gt; DV : Kiểm tra nợ dịch vụ\nDV --&gt; Service : Số dư nợ dịch vụ\nService --&gt; Form : Hiển thị số tháng tối đa\n\nNV -&gt; Form : Nhập số tháng, nhấn Gia hạn\nForm -&gt; Service : GiaHan(maHD, maVP, soThang)\nactivate Service\nService -&gt; GH : BEGIN TRAN\\nINSERT phiếu gia hạn\nService -&gt; HD : UPDATE ngày kết thúc\nService --&gt; Form : COMMIT / thông báo kết quả\ndeactivate Service\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="RTYSHNd2o89WnZn87juG-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam shadowing false\nskinparam monochrome false\nskinparam packageStyle rectangle\n\nclass BenhNhan {\n  + MaBN : String {PK}\n  + HoTen : String\n  + NgaySinh : Date\n  + DiaChi : String\n  + DienThoai : String\n  + Anh3x4 : Byte[]\n  + dangKyMoi() : Boolean\n  + capNhatThongTin() : Boolean\n}\n\nclass HoSoBenhAn {\n  + MaHoSo : String {PK}\n  + MaBN : String {FK}\n  + NgayCap : Date\n  + NgayHetHanLePhi : Date\n  + TrangThai : String\n  + taoHoSo() : Boolean\n  + kiemTraHanLePhi() : Boolean\n  + giaHanLePhi() : Boolean\n}\n\nclass PhieuThuLePhi {\n  + SoPhieuThu : String {PK}\n  + MaHoSo : String {FK}\n  + NgayThu : DateTime\n  + SoTien : Decimal\n  + NamApDung : Integer\n  + lapPhieuThu() : Boolean\n  + inBienLai() : Void\n}\n\nclass LichHenDinhKy {\n  + MaLichHen : String {PK}\n  + MaHoSo : String {FK}\n  + NgayGioHen : DateTime\n  + Quy : Integer\n  + Nam : Integer\n  + TrangThai : String\n  + datLichHen() : Boolean\n  + huyLichHen() : Boolean\n}\n\nclass PhieuKhamBenh {\n  + MaPhieuKham : String {PK}\n  + MaHoSo : String {FK}\n  + MaBS : String {FK}\n  + MaKhoa : String {FK}\n  + NgayGioKham : DateTime\n  + TrieuChung : String\n  + LoaiKham : String\n  + TrangThai : String\n  + taoPhieuKham() : Boolean\n  + capNhatTrieuChung() : Boolean\n  + hoanTatKham() : Boolean\n}\n\nclass BacSi {\n  + MaBS : String {PK}\n  + HoTen : String\n  + ChuyenKhoa : String\n  + DienThoai : String\n  + layDanhSach() : DataTable\n  + themBacSi() : Boolean\n}\n\nclass KhoaDieuTri {\n  + MaKhoa : String {PK}\n  + TenKhoa : String\n  + PhongKham : String\n  + themKhoa() : Boolean\n}\n\nclass XetNghiem {\n  + MaXetNghiem : String {PK}\n  + TenXetNghiem : String\n  + DonGia : Decimal\n  + themXetNghiem() : Boolean\n}\n\nclass ChiDinhXetNghiem {\n  + MaPhieuKham : String {PK, FK}\n  + MaXetNghiem : String {PK, FK}\n  + KetQua : String\n  + NgayThucHien : DateTime\n  + lapChiDinh() : Boolean\n  + capNhatKetQua() : Boolean\n}\n\nclass ToaThuoc {\n  + MaToa : String {PK}\n  + MaPhieuKham : String {FK}\n  + NgayLap : DateTime\n  + DanDoBacSi : String\n  + lapToaThuoc() : Boolean\n  + tinhTienThuoc() : Decimal\n}\n\nclass ChiTietToaThuoc {\n  + MaToa : String {PK, FK}\n  + MaThuoc : String {PK, FK}\n  + SoLuong : Integer\n  + LieuDung : String\n  + themChiTiet() : Boolean\n}\n\nclass Thuoc {\n  + MaThuoc : String {PK}\n  + TenThuoc : String\n  + DonViTinh : String\n  + DonGia : Decimal\n  + themThuoc() : Boolean\n}\n\nclass HoaDonVienPhi {\n  + SoHoaDon : String {PK}\n  + MaPhieuKham : String {FK}\n  + NgayThanhToan : DateTime\n  + TongTienKham : Decimal\n  + TongTienXN : Decimal\n  + TongTienThuoc : Decimal\n  + MienGiam : Decimal\n  + TongThanhToan : Decimal\n  + DaThanhToan : Boolean\n  + lapHoaDon() : Boolean\n  + thanhToan() : Boolean\n}\n\n&#39; Quan hệ giữa các lớp\nBenhNhan \&quot;1\&quot; -- \&quot;1\&quot; HoSoBenhAn : có &gt;\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuThuLePhi : nộp &gt;\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; LichHenDinhKy : đặt &gt;\nHoSoBenhAn \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKhamBenh : lưu &gt;\n\nBacSi \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKhamBenh : khám &gt;\nKhoaDieuTri \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuKhamBenh : thuộc &gt;\n\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;0..*\&quot; ChiDinhXetNghiem\nChiDinhXetNghiem \&quot;0..*\&quot; -- \&quot;1\&quot; XetNghiem\n\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;0..1\&quot; ToaThuoc : kê &gt;\nToaThuoc \&quot;1\&quot; -- \&quot;1..*\&quot; ChiTietToaThuoc\nChiTietToaThuoc \&quot;0..*\&quot; -- \&quot;1\&quot; Thuoc\n\nPhieuKhamBenh \&quot;1\&quot; -- \&quot;0..1\&quot; HoaDonVienPhi : thanh toán &gt;\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Sj3ihyu4HXne_mxjastr-1">

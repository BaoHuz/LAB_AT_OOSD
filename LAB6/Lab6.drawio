        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\nskinparam shadowing false\nskinparam actorStyle stickman\n\nactor \&quot;Bệnh nhân\&quot; as BN\nactor \&quot;NV Lễ tân\&quot; as NVLT\nactor \&quot;Bác sĩ\&quot; as BS\nactor \&quot;Kế toán\&quot; as KT\n\nrectangle \&quot;Phân Rã Quy Trình Đăng Ký Khám - Xét Nghiệm - Toa Thuốc\&quot; {\n\n    usecase \&quot;Đăng ký khám bệnh\&quot; as UC_DKKham\n    usecase \&quot;Thu lệ phí năm &amp; Cấp hồ sơ\&quot; as UC_CapHoSo\n    usecase \&quot;Tra cứu lịch sử bệnh án\&quot; as UC_TraCuu\n\n    usecase \&quot;Khám &amp; Ghi triệu chứng\&quot; as UC_Kham\n    usecase \&quot;Xem lịch sử điều trị\&quot; as UC_XemLS\n    usecase \&quot;Chỉ định xét nghiệm\&quot; as UC_ChiDinhXN\n    \n    usecase \&quot;Lập toa thuốc\&quot; as UC_LapToa\n    usecase \&quot;Kiểm tra chống chỉ định / Phản ứng phụ\&quot; as UC_KiemTraThuoc\n\n    usecase \&quot;Thanh toán viện phí\&quot; as UC_ThanhToan\n    usecase \&quot;Phát thuốc\&quot; as UC_PhatThuoc\n}\n\n&#39; Liên kết Actor\nBN -- UC_DKKham\nNVLT -- UC_DKKham\nNVLT -- UC_TraCuu\nBS -- UC_Kham\nBS -- UC_LapToa\nKT -- UC_ThanhToan\n\n&#39; Mối quan hệ include / extend\nUC_DKKham &lt;.. UC_CapHoSo : &lt;&lt;extend&gt;&gt;\\n[Bệnh nhân mới]\nUC_DKKham ..&gt; UC_TraCuu : &lt;&lt;include&gt;&gt;\n\nUC_Kham ..&gt; UC_XemLS : &lt;&lt;include&gt;&gt;\nUC_Kham &lt;.. UC_ChiDinhXN : &lt;&lt;extend&gt;&gt;\\n[Cần cận lâm sàng]\n\nUC_LapToa ..&gt; UC_KiemTraThuoc : &lt;&lt;include&gt;&gt;\n\nUC_PhatThuoc ..&gt; UC_ThanhToan : &lt;&lt;include&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="c7y7jtE6n8gVAMoGHyuB-1">

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle THIẾT KẾ LỚP CHO CHỨC NĂNG KHÁCH HÀNG - HỢP ĐỒNG\n\nleft to right direction\n\nskinparam shadowing false\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\n\nskinparam class {\n    BackgroundColor #FFF4C2\n    BorderColor #A67C32\n}\n\nclass FrmKhachHang &lt;&lt;boundary&gt;&gt; {\n    + FrmKhachHang_Load()\n    + btnThem_Click()\n    + btnSua_Click()\n    + btnXoa_Click()\n    + dgvKhachHang_CellClick()\n}\n\nclass FrmHopDong &lt;&lt;boundary&gt;&gt; {\n    + FrmHopDong_Load()\n    + btnThemVP_Click()\n    + btnBoVP_Click()\n    + btnLapHopDong_Click()\n}\n\nclass KhachHangService &lt;&lt;control&gt;&gt; {\n    + LayDanhSach()\n    + Them()\n    + Sua()\n    + Xoa()\n}\n\nclass HopDongService &lt;&lt;control&gt;&gt; {\n    + LayKhachHang()\n    + LayVanPhongTrong()\n    + LayHopDong()\n    + LayChiTietHopDong()\n    + LapHopDong()\n}\n\nclass KhachHang &lt;&lt;entity&gt;&gt; {\n    - MaKH : String\n    - TenKhachHang : String\n    - LoaiKhach : String\n    - MaSoThue : String\n    - DienThoai : String\n    --\n    + themKhachHang()\n    + capNhatKhachHang()\n}\n\nclass VanPhong &lt;&lt;entity&gt;&gt; {\n    - MaVP : String\n    - TenPhong : String\n    - DienTichSuDung : Decimal\n    - DonGiaThang : Decimal\n    - TrangThai : String\n    --\n    + kiemTraTrong()\n    + capNhatTrangThai()\n}\n\nclass HopDongThue &lt;&lt;entity&gt;&gt; {\n    - MaHD : String\n    - MaKH : String\n    - NgayBatDau : Date\n    - SoThangThue : Integer\n    - NgayKetThuc : Date\n    --\n    + lapHopDong()\n    + tinhNgayKetThuc()\n}\n\nclass ChiTietHopDong &lt;&lt;entity&gt;&gt; {\n    - MaHD : String\n    - MaVP : String\n    - DonGiaThang : Decimal\n    - NgayKetThuc : Date\n    --\n    + kiemTraChongLich()\n    + themChiTiet()\n}\n\nclass ThanhToanTienThue &lt;&lt;entity&gt;&gt; {\n    - SoTT : String\n    - MaHD : String\n    - KyTuThang : Integer\n    - KyDenThang : Integer\n    - SoTien : Decimal\n    --\n    + taoKy()\n    + ghiThanhToan()\n}\n\nFrmKhachHang --&gt; KhachHangService : gọi\nFrmHopDong --&gt; HopDongService : gọi\n\nKhachHangService --&gt; KhachHang\n\nHopDongService --&gt; KhachHang\nHopDongService --&gt; VanPhong\nHopDongService --&gt; HopDongThue\nHopDongService --&gt; ChiTietHopDong\nHopDongService --&gt; ThanhToanTienThue\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="-uxKeBUo3Z72cYoVNojc-1">

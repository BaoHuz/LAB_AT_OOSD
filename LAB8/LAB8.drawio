  <diagram id="GSuXDQndHiQ9T-AYRqI_" name="P06_sequence_hopdong">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam sequenceMessageAlign center\n\ntitle SEQUENCE DIAGRAM - LẬP HỢP ĐỒNG VÀ THU TRƯỚC 6 THÁNG\n\nactor \&quot;NV quản lý\&quot; as NV\nboundary FrmHopDong as Form\ncontrol HopDongService as Service\nentity VanPhong as VP\nentity HopDong as HD\nentity ChiTietHD as CTHD\nentity ThanhToan as TT\n\nNV -&gt; Form : Nhập KH, thời hạn, chọn nhiều VP\nForm -&gt; Service : LapHopDong()\nactivate Service\nService -&gt; VP : Kiểm tra phòng trống / chồng lịch\nVP --&gt; Service : Kết quả kiểm tra\nService -&gt; HD : BEGIN TRAN\\nINSERT hợp đồng\nService -&gt; CTHD : INSERT danh sách văn phòng\nService -&gt; TT : INSERT thu trước tháng 1-6\nService --&gt; Form : COMMIT + tổng tiền 6 tháng\ndeactivate Service\nForm --&gt; NV : Thông báo thành công\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="07Odc52yGj34nWxLqlYq-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />

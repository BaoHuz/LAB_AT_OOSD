  <diagram id="CwEQv_OJmNp1FZxSl3sf" name="P12_class_phantich_chitiet">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle BIỂU ĐỒ LỚP THIẾT KẾ CHI TIẾT\n\ntop to bottom direction\n\nskinparam shadowing false\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\n\nskinparam class {\n    BackgroundColor #FFF4C2\n    BorderColor #A67C32\n    ArrowColor #A05050\n}\n\nclass Tang {\n    - MaTang : String\n    - TenTang : String\n    - SoThuTu : Integer\n    - GhiChu : String\n    --\n    + themTang()\n    + capNhatTang()\n    + xoaTang()\n    + layDanhSach()\n}\n\nclass VanPhong {\n    - MaVP : String\n    - MaTang : String\n    - TenPhong : String\n    - DienTichSuDung : Decimal\n    - Huong : String\n    - DonGiaThang : Decimal\n    - TrangThai : String\n    --\n    + themVanPhong()\n    + capNhatVanPhong()\n    + xoaVanPhong()\n    + kiemTraTrong()\n    + capNhatTrangThai()\n}\n\nclass KhachHang {\n    - MaKH : String\n    - TenKhachHang : String\n    - LoaiKhach : String\n    - MaSoThue : String\n    - DiaChi : String\n    - DienThoai : String\n    - Email : String\n    --\n    + themKhachHang()\n    + capNhatKhachHang()\n    + xoaKhachHang()\n    + layDanhSach()\n}\n\nclass HopDongThue {\n    - MaHD : String\n    - MaKH : String\n    - NgayKy : Date\n    - NgayBatDau : Date\n    - SoThangThue : Integer\n    - NgayKetThuc : Date\n    - TrangThai : String\n    - GhiChu : String\n    --\n    + lapHopDong()\n    + tinhNgayKetThuc()\n    + kiemTraThoiHan()\n    + huyHopDong()\n    + layDanhSach()\n}\n\nclass ChiTietHopDong {\n    - MaHD : String\n    - MaVP : String\n    - DonGiaThang : Decimal\n    - NgayBatDau : Date\n    - NgayKetThuc : Date\n    - TrangThai : String\n    --\n    + themChiTiet()\n    + kiemTraChongLich()\n    + capNhatNgayKetThuc()\n    + tinhTienThueThang()\n}\n\nclass ThanhToanTienThue {\n    - SoTT : String\n    - MaHD : String\n    - KyTuThang : Integer\n    - KyDenThang : Integer\n    - NgayDenHan : Date\n    - NgayThanhToan : Date\n    - SoTien : Decimal\n    - TrangThai : String\n    - GhiChu : String\n    --\n    + taoKy()\n    + tinhSoTien()\n    + ghiThanhToan()\n    + kiemTraDaThanhToan()\n    + conNo()\n}\n\nclass DichVu {\n    - MaDV : String\n    - TenDV : String\n    - DonViTinh : String\n    - DonGia : Decimal\n    - DangSuDung : Boolean\n    --\n    + themDichVu()\n    + capNhatDichVu()\n    + capNhatDonGia()\n    + layDanhSach()\n}\n\nclass SuDungDichVu {\n    - MaSD : String\n    - MaHD : String\n    - MaVP : String\n    - MaDV : String\n    - ThangSuDung : Date\n    - SoLuong : Decimal\n    - DonGia : Decimal\n    - ThanhTien : Decimal\n    --\n    + ghiSuDung()\n    + tinhThanhTien()\n    + layTheoThang()\n}\n\nclass HoaDonDichVu {\n    - MaHDDV : String\n    - MaHD : String\n    - ThangSuDung : Date\n    - NgayLap : Date\n    - TongTien : Decimal\n    - TrangThai : String\n    --\n    + lapHoaDonThang()\n    + tinhTong()\n    + kiemTraDaLap()\n    + danhDauDaTra()\n}\n\nclass ChiTietHoaDonDichVu {\n    - MaHDDV : String\n    - MaSD : String\n    - SoTien : Decimal\n    --\n    + themChiTiet()\n    + layChiTietHoaDon()\n}\n\nclass ThanhToanDichVu {\n    - SoTTDV : String\n    - MaHDDV : String\n    - NgayThanhToan : Date\n    - SoTien : Decimal\n    - GhiChu : String\n    --\n    + ghiThanhToan()\n    + tongDaTra()\n}\n\nclass PhieuGiaHan {\n    - MaGH : String\n    - MaHD : String\n    - MaVP : String\n    - NgayLap : Date\n    - SoThangGiaHan : Integer\n    - TuNgay : Date\n    - DenNgay : Date\n    - GhiChu : String\n    --\n    + kiemTraDieuKien()\n    + tinhGioiHanGiaHan()\n    + tinhNgayKetThucMoi()\n    + giaHan()\n}\n\nclass NhanVienVanPhong {\n    - MaNV : String\n    - MaKH : String\n    - MaVP : String\n    - HoTen : String\n    - ChucVu : String\n    - HinhAnh : Byte[]\n    - NgayBatDau : Date\n    - DangLamViec : Boolean\n    --\n    + themNhanVien()\n    + capNhatNhanVien()\n    + chuyenPhong()\n    + nghiViec()\n}\n\nclass TheGiuXe {\n    - MaThe : String\n    - MaNV : String\n    - BienSoXe : String\n    - LoaiXe : String\n    - MauXe : String\n    - NgayCap : Date\n    - TrangThai : String\n    --\n    + capThe()\n    + capNhatThe()\n    + khoaThe()\n    + thuHoi()\n}\n\nclass KiemTraPhong {\n    - MaKT : String\n    - MaVP : String\n    - NgayKiemTra : Date\n    - TinhTrang : String\n    - CoThayDoiKetCau : Boolean\n    - MucPhat : Decimal\n    - KienNghiSuaChua : String\n    - NguoiKiemTra : String\n    --\n    + lapBienBan()\n    + ghiNhanViPham()\n    + tinhMucPhat()\n    + deXuatSuaChua()\n}\n\nTang \&quot;1\&quot; *-- \&quot;1..*\&quot; VanPhong : gồm\n\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; HopDongThue : ký\nKhachHang \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienVanPhong : có\n\nHopDongThue \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietHopDong : gồm\nVanPhong \&quot;1\&quot; -- \&quot;0..*\&quot; ChiTietHopDong : được thuê\n\nHopDongThue \&quot;1\&quot; -- \&quot;1..*\&quot; ThanhToanTienThue : thanh toán\n\nChiTietHopDong \&quot;1\&quot; -- \&quot;0..*\&quot; SuDungDichVu : sử dụng\nDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; SuDungDichVu : dịch vụ\n\nHopDongThue \&quot;1\&quot; -- \&quot;0..*\&quot; HoaDonDichVu : phát sinh\nHoaDonDichVu \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietHoaDonDichVu : gồm\nSuDungDichVu \&quot;1\&quot; -- \&quot;0..1\&quot; ChiTietHoaDonDichVu : được tổng hợp\nHoaDonDichVu \&quot;1\&quot; -- \&quot;0..*\&quot; ThanhToanDichVu : thanh toán\n\nChiTietHopDong \&quot;1\&quot; -- \&quot;0..*\&quot; PhieuGiaHan : gia hạn\n\nVanPhong \&quot;1\&quot; -- \&quot;0..*\&quot; NhanVienVanPhong : làm việc tại\nNhanVienVanPhong \&quot;1\&quot; -- \&quot;0..1\&quot; TheGiuXe : được cấp\n\nVanPhong \&quot;1\&quot; -- \&quot;0..*\&quot; KiemTraPhong : được kiểm tra\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="JTJ_KjXipFmiGPz-bS-H-1">

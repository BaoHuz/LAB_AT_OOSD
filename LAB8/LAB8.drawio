        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle THIẾT KẾ LỚP CHO CHỨC NĂNG DỊCH VỤ - HÓA ĐƠN\n\nleft to right direction\n\nskinparam shadowing false\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\n\nskinparam class {\n    BackgroundColor #FFF4C2\n    BorderColor #A67C32\n}\n\nclass FrmDichVu &lt;&lt;boundary&gt;&gt; {\n    + FrmDichVu_Load()\n    + btnThemDV_Click()\n    + btnSuaDV_Click()\n    + btnGhiNhan_Click()\n    + cboHopDong_SelectedIndexChanged()\n}\n\nclass FrmHoaDonDichVu &lt;&lt;boundary&gt;&gt; {\n    + FrmHoaDonDichVu_Load()\n    + btnLapHoaDon_Click()\n    + btnThanhToan_Click()\n    + dgvHoaDon_CellClick()\n}\n\nclass DichVuService &lt;&lt;control&gt;&gt; {\n    + LayDichVu()\n    + ThemDichVu()\n    + SuaDichVu()\n    + LayHopDong()\n    + LayVanPhongTheoHopDong()\n    + GhiNhanSuDung()\n    + LaySuDungDichVu()\n}\n\nclass HoaDonDichVuService &lt;&lt;control&gt;&gt; {\n    + LayHoaDon()\n    + LayChiTietHoaDon()\n    + LapHoaDon()\n    + ThanhToanHoaDon()\n}\n\nclass DichVu &lt;&lt;entity&gt;&gt; {\n    - MaDV : String\n    - TenDV : String\n    - DonViTinh : String\n    - DonGia : Decimal\n    --\n    + themDichVu()\n    + capNhatDonGia()\n}\n\nclass SuDungDichVu &lt;&lt;entity&gt;&gt; {\n    - MaSD : String\n    - MaHD : String\n    - MaVP : String\n    - MaDV : String\n    - ThangSuDung : Date\n    - SoLuong : Decimal\n    - ThanhTien : Decimal\n    --\n    + ghiSuDung()\n    + tinhThanhTien()\n}\n\nclass HoaDonDichVu &lt;&lt;entity&gt;&gt; {\n    - MaHDDV : String\n    - MaHD : String\n    - ThangSuDung : Date\n    - TongTien : Decimal\n    - TrangThai : String\n    --\n    + lapHoaDonThang()\n    + tinhTong()\n    + danhDauDaTra()\n}\n\nclass ChiTietHoaDonDichVu &lt;&lt;entity&gt;&gt; {\n    - MaHDDV : String\n    - MaSD : String\n    - SoTien : Decimal\n    --\n    + themChiTiet()\n}\n\nclass ThanhToanDichVu &lt;&lt;entity&gt;&gt; {\n    - SoTTDV : String\n    - MaHDDV : String\n    - NgayThanhToan : Date\n    - SoTien : Decimal\n    --\n    + ghiThanhToan()\n    + tongDaTra()\n}\n\nclass ChiTietHopDong &lt;&lt;entity&gt;&gt; {\n    - MaHD : String\n    - MaVP : String\n    - TrangThai : String\n}\n\nFrmDichVu --&gt; DichVuService : gọi\nFrmHoaDonDichVu --&gt; HoaDonDichVuService : gọi\n\nDichVuService --&gt; DichVu\nDichVuService --&gt; SuDungDichVu\nDichVuService --&gt; ChiTietHopDong\n\nHoaDonDichVuService --&gt; SuDungDichVu\nHoaDonDichVuService --&gt; HoaDonDichVu\nHoaDonDichVuService --&gt; ChiTietHoaDonDichVu\nHoaDonDichVuService --&gt; ThanhToanDichVu\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="wf35SPUjuavXo6ipdkfP-1">

        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam shadowing false\nskinparam defaultFontName Arial\nskinparam classAttributeIconSize 0\nhide circle\n\nclass PhongBan {\n  +MaPB\n  +TenPB\n  +LoaiDonVi\n}\nclass NhanVien {\n  +MaNV\n  +HoTen\n  +TrangThai\n}\nabstract class QuyetDinhNhanSu {\n  +SoQD\n  +NgayQD\n  +NoiDung\n  +NguoiKy\n}\nclass QuyetDinhTuyenDung {\n  +TuNgay\n  +DenNgay\n  +LuongThuViec\n}\nclass QuyetDinhChucVu {\n  +NgayHieuLuc\n  +PhuCapChucVu\n}\nclass QuyetDinhLuong {\n  +NgayHieuLuc\n  +LuongCoBan\n  +PhuCapLuong\n  +PhuCapDocHai\n}\nclass QuyetDinhKhenThuong {\n  +LoaiKhenThuong\n  +SoTien\n}\nclass QuyetDinhKyLuat {\n  +SoTienPhat\n  +CachThu\n}\nclass HopDongLaoDong {\n  +SoHD\n  +LoaiHD\n  +TuNgay\n  +DenNgay\n}\nclass HoSoBaoHiem {\n  +MaHSBH\n  +LoaiBH\n  +TyLeNguoiLD\n  +TuNgay\n}\nclass ChucVu {\n  +MaCV\n  +TenCV\n}\nclass KeHoachTuan {\n  +MaKH\n  +TuanTuNgay\n  +TuanDenNgay\n}\nclass ChiTietKeHoachTuan {\n  +STT\n  +NgayLam\n  +KeHoachPhuTroi\n}\nclass CaLamViec {\n  +MaCa\n  +TenCa\n  +GioBatDau\n  +GioKetThuc\n}\nclass PhieuChamCong {\n  +MaCC\n  +NgayCham\n  +SoGioLam\n  +TrangThai\n}\nclass PhieuPhuTroi {\n  +SoPhieu\n  +NgayPhuTroi\n  +SoGioPhuTroi\n  +HinhThuc\n  +HeSo = 1.5\n}\nclass ChiTietPhuTroi {\n  +SoPhieu + MaNV\n}\nclass PhieuChiKhenThuong {\n  +SoPhieuChi\n  +NgayChi\n  +SoTien\n}\nclass PhieuThuNopPhat {\n  +SoPhieuThu\n  +NgayThu\n  +SoTien\n}\nclass BangLuong {\n  +MaBangLuong\n  +Thang\n  +Nam\n  +TrangThai\n}\nclass ChiTietBangLuong {\n  +MaBangLuong + MaNV\n  +TienTheoCong\n  +TienPhuTroi\n  +KhauTruBaoHiem\n  +KhauTruKyLuat\n  +ThucLinh\n}\n\nNhanVien \&quot;0..*\&quot; -- \&quot;1\&quot; PhongBan\nQuyetDinhNhanSu &lt;|-- QuyetDinhTuyenDung\nQuyetDinhNhanSu &lt;|-- QuyetDinhChucVu\nQuyetDinhNhanSu &lt;|-- QuyetDinhLuong\nQuyetDinhNhanSu &lt;|-- QuyetDinhKhenThuong\nQuyetDinhNhanSu &lt;|-- QuyetDinhKyLuat\nQuyetDinhTuyenDung \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\nQuyetDinhTuyenDung \&quot;*\&quot; -- \&quot;1\&quot; PhongBan : thử việc tại\nHopDongLaoDong \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\nHoSoBaoHiem \&quot;*\&quot; -- \&quot;1\&quot; HopDongLaoDong\nHoSoBaoHiem \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\nQuyetDinhChucVu \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\nQuyetDinhChucVu \&quot;*\&quot; -- \&quot;1\&quot; ChucVu\nQuyetDinhLuong \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\nKeHoachTuan \&quot;*\&quot; -- \&quot;1\&quot; PhongBan\nKeHoachTuan \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietKeHoachTuan\nChiTietKeHoachTuan \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\nChiTietKeHoachTuan \&quot;*\&quot; -- \&quot;1\&quot; CaLamViec\nPhieuChamCong \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\nPhieuChamCong \&quot;*\&quot; -- \&quot;1\&quot; CaLamViec\nPhieuPhuTroi \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietPhuTroi\nChiTietPhuTroi \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\nQuyetDinhKhenThuong \&quot;*\&quot; -- \&quot;0..1\&quot; NhanVien\nQuyetDinhKhenThuong \&quot;*\&quot; -- \&quot;0..1\&quot; PhongBan\nQuyetDinhKhenThuong \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuChiKhenThuong\nQuyetDinhKyLuat \&quot;*\&quot; -- \&quot;0..1\&quot; NhanVien\nQuyetDinhKyLuat \&quot;*\&quot; -- \&quot;0..1\&quot; PhongBan\nQuyetDinhKyLuat \&quot;1\&quot; -- \&quot;0..1\&quot; PhieuThuNopPhat\nBangLuong \&quot;1\&quot; *-- \&quot;1..*\&quot; ChiTietBangLuong\nChiTietBangLuong \&quot;*\&quot; -- \&quot;1\&quot; NhanVien\n\nnote right of QuyetDinhKhenThuong\nMỗi quyết định nhắm đúng một đối tượng:\nNhanVien hoặc PhongBan.\nend note\nnote right of QuyetDinhKyLuat\nMỗi quyết định nhắm đúng một đối tượng:\nNhanVien hoặc PhongBan.\nend note\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="JOnXjXA1-8SYuw_9WY63-1">
